# Live backend (admin dashboard + API are hosted remotely).
# Local storefront uses Vite proxy → this host (see vite.config.js).
VITE_API_BASE_URL=https://ozven.vercel.app/api/public

# Optional: override proxy target only (defaults to origin of VITE_API_BASE_URL)
# VITE_API_PROXY_TARGET=https://ozven.vercel.app

# WhatsApp floating button (digits only, with country code, no +)
# VITE_WHATSAPP_NUMBER=15550101234
