# Must be an absolute URL including protocol (https://).
# Wrong:  ozven.vercel.app/api
# Right:  https://ozven.vercel.app/api
#
# Local:
VITE_API_BASE_URL=http://localhost:5000/api
#
# Production (set the same value in Vercel Project → Environment Variables):
# VITE_API_BASE_URL=https://ozven.vercel.app/api
